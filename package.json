{
  "name": "dsh-token-billing",
  "version": "0.2.1",
  "description": "Live billing chip for DeepSeek Harness — appends an estimated session cost (¥) to the composer dock row, with hover amount and a click-open breakdown panel",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "preview": "bash preview/shot.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run test",
    "prepublishOnly": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "oxlint": "^1.87.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "billing",
    "cost",
    "tokens"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eivmosn/dsh-token-billing.git"
  },
  "homepage": "https://github.com/eivmosn/dsh-token-billing#readme",
  "bugs": {
    "url": "https://github.com/eivmosn/dsh-token-billing/issues"
  }
}
